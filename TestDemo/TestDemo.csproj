<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 默认不引用插件工程，TestDemo 还是那个干净的空壳；要跑剪贴板测试再加 -p:WithClipboardTest=true -->
    <WithClipboardTest Condition="'$(WithClipboardTest)' == ''">false</WithClipboardTest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WithClipboardTest)' == 'true'">
    <DefineConstants>$(DefineConstants);WITH_CLIPBOARD_TEST</DefineConstants>
    <!-- 录制对话框预览模式要建 WPF 窗口 -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup Condition="'$(WithClipboardTest)' == 'true'">
    <ProjectReference Include="..\Flow.Launcher.Plugin.FillTextToWindows\Flow.Launcher.Plugin.FillTextToWindows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WithClipboardTest)' != 'true'">
    <Compile Remove="ClipboardSnapshotTest.cs" />
    <Compile Remove="KeyboardLayoutTest.cs" />
    <Compile Remove="ShortcutRecorderPreview.cs" />
  </ItemGroup>

</Project>
