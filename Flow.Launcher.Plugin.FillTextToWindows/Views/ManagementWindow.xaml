<Window
    x:Class="Flow.Launcher.Plugin.FillTextToWindows.Views.ManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Flow.Launcher.Plugin.FillTextToWindows.ViewModels"
    Title="FillTextToWindows 数据管理"
    Width="880"
    Height="600"
    MinWidth="760"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=vm:ManagementViewModel}"
    FontSize="13"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左：已保存的记录  -->
            <DockPanel Grid.Column="0">
                <TextBlock
                    Margin="2,0,0,6"
                    DockPanel.Dock="Top"
                    FontWeight="SemiBold"
                    Text="已保存的记录" />
                <StackPanel
                    Margin="0,8,0,0"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Width="76"
                        Padding="0,3"
                        Click="OnNewClick"
                        Content="新建" />
                    <Button
                        Width="76"
                        Margin="8,0,0,0"
                        Padding="0,3"
                        Click="OnDeleteClick"
                        Content="删除" />
                </StackPanel>
                <ListBox
                    x:Name="EntryList"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Entries}"
                    SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" />
            </DockPanel>

            <!--  右：编辑表单  -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Text="名称" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="4,3"
                            Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,10,10,0"
                            VerticalAlignment="Top"
                            Text="数据" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,10,0,0">
                            <ItemsControl x:Name="ValueList" ItemsSource="{Binding Draft.Values}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="#FF9A9A9A"
                                                Text="{Binding Order}" />
                                            <TextBox
                                                Grid.Column="1"
                                                Padding="4,3"
                                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="2"
                                                Width="52"
                                                Margin="6,0,0,0"
                                                Padding="0,2"
                                                Click="OnRemoveValueClick"
                                                Content="删除" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Margin="0,4,0,0"
                                Padding="10,3"
                                HorizontalAlignment="Left"
                                Click="OnAddValueClick"
                                Content="+ 添加数据" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="96,6,0,0"
                        FontSize="12"
                        Foreground="#FF6B6B6B"
                        Text="{Binding Draft.SegmentSummary}" />

                    <CheckBox
                        Margin="0,16,0,0"
                        Content="自定义配置（不勾选时这条记录直接用插件的全局配置）"
                        IsChecked="{Binding Draft.UseCustomSettings}" />

                    <Grid Margin="0,8,0,0" IsEnabled="{Binding Draft.UseCustomSettings}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="86" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="开始前按键" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="150"
                            Margin="0,0,0,4"
                            Padding="4,3"
                            Text="{Binding Draft.LeadingKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="10,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.LeadingKeys.Preview}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="切换输入框" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            MinWidth="150"
                            Margin="0,0,0,4"
                            Padding="4,3"
                            Text="{Binding Draft.NextFieldKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="10,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.NextFieldKeys.Preview}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="最后一段之后" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            MinWidth="150"
                            Margin="0,0,0,4"
                            Padding="4,3"
                            Text="{Binding Draft.LastFieldKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="10,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.LastFieldKeys.Preview}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="粘贴后等待" />
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,4">
                            <TextBlock
                                DockPanel.Dock="Right"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FF6B6B6B"
                                Text="毫秒" />
                            <TextBox Padding="4,3" Text="{Binding Draft.CustomSettings.PasteDelayMs}" />
                        </DockPanel>

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="按键间隔" />
                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,4">
                            <TextBlock
                                DockPanel.Dock="Right"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FF6B6B6B"
                                Text="毫秒" />
                            <TextBox Padding="4,3" Text="{Binding Draft.CustomSettings.KeyDelayMs}" />
                        </DockPanel>

                        <CheckBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,4,0,0"
                            Content="填充完成后把剪贴板还原成原来的内容"
                            IsChecked="{Binding Draft.CustomSettings.RestoreClipboard}" />
                    </Grid>

                    <StackPanel
                        Margin="0,20,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="92"
                            Padding="0,4"
                            Click="OnSaveClick"
                            Content="保存" />
                        <Button
                            Width="92"
                            Margin="8,0,0,0"
                            Padding="0,4"
                            Click="OnClearClick"
                            Content="清空表单" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="8,6"
            Background="#FFF3F3F3"
            CornerRadius="3">
            <TextBlock
                Foreground="#FF444444"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
