<Window
    x:Class="Flow.Launcher.Plugin.FillTextToWindows.Views.ManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Flow.Launcher.Plugin.FillTextToWindows.ViewModels"
    Title="FillTextToWindows 数据管理"
    Width="1000"
    Height="620"
    MinWidth="920"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=vm:ManagementViewModel}"
    FontSize="13"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <!-- 「数据行配置模式」的总开关：关着的时候每行的按键设置整块不显示 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左：已保存的记录  -->
            <DockPanel Grid.Column="0">
                <TextBlock
                    Margin="2,0,0,6"
                    DockPanel.Dock="Top"
                    FontWeight="SemiBold"
                    Text="已保存的记录" />
                <StackPanel
                    Margin="0,8,0,0"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Width="76"
                        Padding="0,3"
                        Click="OnNewClick"
                        Content="新建" />
                    <Button
                        Width="76"
                        Margin="8,0,0,0"
                        Padding="0,3"
                        Click="OnDeleteClick"
                        Content="删除" />
                </StackPanel>
                <ListBox
                    x:Name="EntryList"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Entries}"
                    SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" />
            </DockPanel>

            <!--  右：编辑表单  -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Text="名称" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="4,3"
                            Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,10,10,0"
                            VerticalAlignment="Top"
                            Text="数据" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,10,0,0">

                            <CheckBox
                                Margin="0,0,0,6"
                                Content="数据行配置模式（每一段配自己的按键，和下面的主表配置叠加）"
                                IsChecked="{Binding Draft.UseLineSettings}"
                                ToolTip="开始前按键只在第 1 段粘贴之前发一次；粘贴后按键填了会顶掉主表的「切换输入框」；最后一段之后按键排在主表的前面。" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="12"
                                Foreground="#FF6B6B6B"
                                TextWrapping="Wrap"
                                Visibility="{Binding Draft.UseLineSettings, Converter={StaticResource BoolToVisibility}}"
                                Text="开始前按键只在第 1 段粘贴之前发一次；粘贴后按键填了会顶掉主表的「切换输入框」；最后一段之后按键排在主表的前面。" />

                            <ItemsControl x:Name="ValueList" ItemsSource="{Binding Draft.Values}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#FF9A9A9A"
                                                    Text="{Binding Order}" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Padding="4,3"
                                                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Width="52"
                                                    Margin="6,0,0,0"
                                                    Padding="0,2"
                                                    Click="OnRemoveValueClick"
                                                    Content="删除" />
                                            </Grid>

                                            <!--
                                                这一段的按键。整块跟着「数据行配置模式」显示 / 隐藏，
                                                免得没开这个模式时数据行看着一大坨。
                                            -->
                                            <WrapPanel
                                                Margin="24,4,0,0"
                                                Visibility="{Binding DataContext.Draft.UseLineSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">

                                                <StackPanel
                                                    Margin="0,0,14,4"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding IsFirst, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="#FF6B6B6B"
                                                        Text="开始前" />
                                                    <TextBox
                                                        Width="88"
                                                        Padding="3,2"
                                                        FontSize="12"
                                                        Text="{Binding LeadingKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button
                                                        Width="38"
                                                        Margin="4,0,0,0"
                                                        Padding="0,1"
                                                        VerticalAlignment="Center"
                                                        Click="OnRecordValueLeadingKeysClick"
                                                        Content="录制"
                                                        FontSize="11"
                                                        ToolTip="弹出键盘图，敲键盘、点键帽都能录" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="#FFC0392B"
                                                        Text="{Binding LeadingKeys.Error}" />
                                                </StackPanel>

                                                <StackPanel
                                                    Margin="0,0,14,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="#FF6B6B6B"
                                                        Text="粘贴后" />
                                                    <TextBox
                                                        Width="88"
                                                        Padding="3,2"
                                                        FontSize="12"
                                                        Text="{Binding NextFieldKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button
                                                        Width="38"
                                                        Margin="4,0,0,0"
                                                        Padding="0,1"
                                                        VerticalAlignment="Center"
                                                        Click="OnRecordValueNextFieldKeysClick"
                                                        Content="录制"
                                                        FontSize="11"
                                                        ToolTip="弹出键盘图，敲键盘、点键帽都能录" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="#FFC0392B"
                                                        Text="{Binding NextFieldKeys.Error}" />
                                                </StackPanel>

                                                <StackPanel
                                                    Margin="0,0,0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="#FF6B6B6B"
                                                        Text="最后之后" />
                                                    <TextBox
                                                        Width="88"
                                                        Padding="3,2"
                                                        FontSize="12"
                                                        Text="{Binding LastFieldKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button
                                                        Width="38"
                                                        Margin="4,0,0,0"
                                                        Padding="0,1"
                                                        VerticalAlignment="Center"
                                                        Click="OnRecordValueLastFieldKeysClick"
                                                        Content="录制"
                                                        FontSize="11"
                                                        ToolTip="弹出键盘图，敲键盘、点键帽都能录" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="#FFC0392B"
                                                        Text="{Binding LastFieldKeys.Error}" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Margin="0,4,0,0"
                                Padding="10,3"
                                HorizontalAlignment="Left"
                                Click="OnAddValueClick"
                                Content="+ 添加数据" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="96,6,0,0"
                        FontSize="12"
                        Foreground="#FF6B6B6B"
                        Text="{Binding Draft.SegmentSummary}" />

                    <CheckBox
                        Margin="0,16,0,0"
                        Content="自定义按键（不勾选时这三个按键走插件的全局配置）"
                        IsChecked="{Binding Draft.UseCustomSettings}" />

                    <Grid Margin="0,8,0,0" IsEnabled="{Binding Draft.UseCustomSettings}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="86" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="开始前按键" />
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            Orientation="Horizontal">
                            <TextBox
                                MinWidth="150"
                                Padding="4,3"
                                VerticalAlignment="Center"
                                Text="{Binding Draft.LeadingKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Width="52"
                                Margin="6,0,0,0"
                                Padding="0,2"
                                VerticalAlignment="Center"
                                Click="OnRecordLeadingKeysClick"
                                Content="录制"
                                ToolTip="弹出键盘图，敲键盘、点键帽都能录" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="10,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.LeadingKeys.Preview}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="切换输入框" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            Orientation="Horizontal">
                            <TextBox
                                MinWidth="150"
                                Padding="4,3"
                                VerticalAlignment="Center"
                                Text="{Binding Draft.NextFieldKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Width="52"
                                Margin="6,0,0,0"
                                Padding="0,2"
                                VerticalAlignment="Center"
                                Click="OnRecordNextFieldKeysClick"
                                Content="录制"
                                ToolTip="弹出键盘图，敲键盘、点键帽都能录" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="10,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.NextFieldKeys.Preview}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="最后一段之后" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            Orientation="Horizontal">
                            <TextBox
                                MinWidth="150"
                                Padding="4,3"
                                VerticalAlignment="Center"
                                Text="{Binding Draft.LastFieldKeys.Text, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Width="52"
                                Margin="6,0,0,0"
                                Padding="0,2"
                                VerticalAlignment="Center"
                                Click="OnRecordLastFieldKeysClick"
                                Content="录制"
                                ToolTip="弹出键盘图，敲键盘、点键帽都能录" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="10,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.LastFieldKeys.Preview}" />

                    </Grid>

                    <!--
                        这三个不跟着「自定义按键」的开关变灰：它们本来就是一项一项独立覆盖的，
                        留空就跟着全局设置走，所以不必先把整条记录切成自定义模式。
                    -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="86" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="粘贴后等待" />
                        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                            <TextBlock
                                DockPanel.Dock="Right"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FF6B6B6B"
                                Text="毫秒" />
                            <TextBox
                                MinWidth="150"
                                Padding="4,3"
                                Text="{Binding Draft.PasteDelayText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="留空就是跟着全局设置走" />
                        </DockPanel>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="10,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.PasteDelayHint}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Text="按键间隔" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                            <TextBlock
                                DockPanel.Dock="Right"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FF6B6B6B"
                                Text="毫秒" />
                            <TextBox
                                MinWidth="150"
                                Padding="4,3"
                                Text="{Binding Draft.KeyDelayText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="留空就是跟着全局设置走" />
                        </DockPanel>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="10,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.KeyDelayHint}" />

                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,4,0,0"
                            VerticalAlignment="Center"
                            Content="填充完成后把剪贴板还原成原来的内容"
                            IsChecked="{Binding Draft.RestoreClipboard}"
                            IsThreeState="True"
                            ToolTip="半选（灰底方框）= 跟着全局设置走" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="10,4,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding Draft.RestoreClipboardHint}" />
                    </Grid>

                    <StackPanel
                        Margin="0,20,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="92"
                            Padding="0,4"
                            Click="OnSaveClick"
                            Content="保存" />
                        <Button
                            Width="92"
                            Margin="8,0,0,0"
                            Padding="0,4"
                            Click="OnClearClick"
                            Content="清空表单" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="8,6"
            Background="#FFF3F3F3"
            CornerRadius="3">
            <TextBlock
                Foreground="#FF444444"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
