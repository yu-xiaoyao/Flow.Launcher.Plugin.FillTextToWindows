<Window
    x:Class="Flow.Launcher.Plugin.FillTextToWindows.Views.ShortcutRecorderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Flow.Launcher.Plugin.FillTextToWindows.ViewModels"
    Title="FillTextToWindows 录制按键"
    d:DataContext="{d:DesignInstance Type=vm:ShortcutRecorderViewModel}"
    FontSize="13"
    MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}"
    MaxWidth="{x:Static SystemParameters.PrimaryScreenWidth}"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>

        <!--  键盘图上的键帽：平时白底，点亮（按住 / 点出来）的时候蓝底  -->
        <Style x:Key="KeyCapStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFC0C0C0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="Padding" Value="0" />
            <!--  这张图是鼠标点的：别抢焦点，也别进 Tab 顺序（按 Tab 是要录 Tab 这个键）  -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!--  显式写全，免得宿主（Flow Launcher）的隐式 Button 样式改掉键帽的大小  -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!--  触发器只改边框色，这样「点亮」的背景色不会被鼠标悬停盖掉  -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7FA8E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3D6FBF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="KeyCapOnStyle"
            BasedOn="{StaticResource KeyCapStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFBFD7FF" />
            <Setter Property="BorderBrush" Value="#FF6B9BE0" />
        </Style>

        <!--  记录结果里每条旁边那几个小按钮（左移 / 右移 / 删掉）  -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF808080" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFDDDDDD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        外面这层 ScrollViewer 是给「屏幕装不下整张键盘图」准备的：窗口大小由内容决定
        （SizeToContent），被窗口的 MaxWidth / MaxHeight 卡住的时候就在这里滚，别把按钮裁掉。
        行宽全都用 Auto —— SizeToContent 碰到 * 行会算错，底下的按钮会被裁。
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  这里故意不写 _ 开头的访问键：按住 Alt 的时候访问键不走按键事件，拦不住  -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    Foreground="#FF444444"
                    TextWrapping="Wrap"
                    Text="按下要发送的按键组合，或者点下面的键盘图。按住 Ctrl / Alt / Shift / Win 再按别的键就是组合键；点修饰键是「按住」，再点一个普通键就记一条。" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="#FF6B6B6B"
                    TextWrapping="Wrap"
                    Text="Shift 加数字或符号会写成那个上档字符本身（Shift+1 就是 !），解析回来还是同一个键。" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="#FF6B6B6B"
                    TextWrapping="Wrap"
                    Text="Esc 是取消（要录 Esc 请点键盘图上的 Esc）。Alt+Tab、Win+字母 这类被系统抢走的键录不到；小键盘回车和主回车是同一个键。" />
            </StackPanel>

            <!--  记录结果  -->
            <Border
                Grid.Row="1"
                MinHeight="76"
                Margin="0,10,0,0"
                Padding="8"
                Background="#FFF3F3F3"
                CornerRadius="4">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#FF9A9A9A"
                        Text="还没有录到按键"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChords}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Chords}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,6,6"
                                        Padding="3,2"
                                        Background="White"
                                        BorderBrush="#FFD0D0D0"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Click="OnMoveUpClick"
                                                Content="◀"
                                                Style="{StaticResource ChipButtonStyle}"
                                                ToolTip="往前挪一位" />
                                            <Button
                                                Click="OnMoveDownClick"
                                                Content="▶"
                                                Style="{StaticResource ChipButtonStyle}"
                                                ToolTip="往后挪一位" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="#FF9A9A9A"
                                                Text="{Binding Order, StringFormat={}{0}.}" />
                                            <TextBlock
                                                Margin="3,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding Text}" />
                                            <Button
                                                Margin="5,0,0,0"
                                                Click="OnRemoveClick"
                                                Content="✕"
                                                Style="{StaticResource ChipButtonStyle}"
                                                ToolTip="删掉这一条" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  当前按住的和保存后会写进输入框的内容  -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#FF6B6B6B"
                        Text="当前按住：" />
                    <TextBlock
                        MinWidth="80"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding PendingText}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#FF6B6B6B"
                        Text="保存后写入：" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding Preview}" />
                </StackPanel>

                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="#FFC03030"
                    Text="{Binding Notice}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!--  键盘图，键帽是代码生成的（见 KeyboardLayout.cs）  -->
            <Border
                Grid.Row="3"
                Margin="0,10,0,0"
                Padding="8"
                Background="#FFF3F3F3"
                CornerRadius="4">
                <!--  窗口被 MaxWidth 卡住的时候只滚键盘图，上面的记录和下面的按钮都不动  -->
                <ScrollViewer x:Name="KeyboardScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="KeyboardHost" />
                </ScrollViewer>
            </Border>

            <StackPanel
                Grid.Row="4"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="16,4"
                    Click="OnClearClick"
                    Content="清空"
                    IsEnabled="{Binding HasChords}" />
                <Button
                    Margin="0,0,8,0"
                    Padding="16,4"
                    Click="OnCancelClick"
                    Content="取消"
                    IsCancel="True" />
                <Button
                    Padding="16,4"
                    Click="OnSaveClick"
                    Content="保存" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
